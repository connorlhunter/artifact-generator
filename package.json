{
  "name": "artifact-generator",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Artifact Generator for architecture documentation and diagrams",
  "scripts": {
    "audit": "bun run deps:policy:check && bun audit --audit-level=high",
    "artifacts:assemble": "SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun scripts/publish/assemble-site-artifacts.ts",
    "artifacts:build": "bun run test:coverage && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun scripts/publish/build-site-artifacts.ts",
    "artifacts:publish": "bun scripts/publish/publish-site-artifacts.ts",
    "artifacts:ship": "bun run test:coverage && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun scripts/publish/ship-site-artifacts.ts",
    "artifacts:source:publish": "SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun scripts/publish/publish-source-inputs.ts",
    "artifacts:source:sync": "SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun scripts/publish/sync-source-inputs.ts",
    "deps:policy": "bun scripts/dependencies/sync-dependency-policy.ts",
    "deps:policy:check": "bun scripts/dependencies/sync-dependency-policy.ts --check",
    "build": "bun scripts/core/clean-dist.ts && bun x tsgo -p tsconfig.json",
    "typecheck": "bun x tsgo --noEmit -p tsconfig.json",
    "version:check": "bun scripts/release/check-release-version.ts",
    "format": "bun x prettier --write . --ignore-unknown",
    "format:check": "bun x prettier --check . --ignore-unknown",
    "lint": "bun x eslint .",
    "test": "bun run build && bun test --isolate --timeout 30000",
    "test:coverage": "bun run build && bun scripts/coverage/clean-coverage.ts && bun test --isolate --coverage --timeout 30000 && bun scripts/coverage/render-coverage-report.ts",
    "coverage:open": "bun run test:coverage && bun dist/scripts/coverage/open-coverage-report.js",
    "docs:render": "bun run build && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun dist/scripts/docs/render-docs-preview.js",
    "docs:render:pdf": "bun run build && bun dist/scripts/docs/render-docs-pdf.js",
    "docs:open": "bun scripts/docs/open-docs-preview.ts",
    "docs:render:open": "bun run build && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun dist/scripts/docs/render-open-docs-preview.js",
    "diagrams:validate": "bun run build && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun dist/scripts/diagrams/validate-diagrams.js",
    "diagrams:render": "bun run build && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun dist/scripts/diagrams/render-diagrams.js",
    "diagrams:open": "bun run build && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun dist/scripts/diagrams/open-diagrams.js",
    "diagrams:render:open": "bun run build && SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun dist/scripts/diagrams/render-open-diagrams.js",
    "resume:build": "SOURCE_INPUT_CACHE_DIR=tmp/s3-inputs bun scripts/resume/build-resume.ts",
    "prepare": "bun scripts/git-hooks/setup-git-hooks.ts",
    "verify": "bun run version:check && bun run audit && bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "bun x prettier --write",
      "bun x eslint --fix"
    ],
    "*.md": [
      "bun x prettier --write",
      "bun x eslint --fix"
    ],
    "*.{json,html}": [
      "bun x prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.2.0",
    "marked": "^18.0.7",
    "prettier": "^3.9.6",
    "puppeteer": "^25.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "string-width": "4.2.3",
    "tar-fs": "2.1.4",
    "ws": "8.21.0"
  }
}
