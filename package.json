{
  "name": "artifact-generator",
  "version": "1.7.6",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "toolchain": {
    "codeql": "2.26.3"
  },
  "description": "Artifact Generator for architecture documentation and diagrams",
  "scripts": {
    "audit": "bun run deps:policy:check && bun audit --audit-level=high",
    "artifacts:assemble": "bun scripts/publish/assemble-site-artifacts.ts",
    "artifacts:build": "bun run test:coverage && bun scripts/publish/build-site-artifacts.ts",
    "artifacts:last-updated": "bun scripts/publish/update-content-manifest.ts",
    "artifacts:publish": "bun scripts/publish/publish-site-artifacts.ts",
    "artifacts:serve": "bun scripts/local/serve-site-artifacts.ts",
    "artifacts:ship": "bun run test:coverage && bun scripts/publish/ship-site-artifacts.ts",
    "artifacts:source:publish": "bun scripts/publish/publish-source-inputs.ts",
    "artifacts:source:sync": "bun scripts/publish/sync-source-inputs.ts",
    "changelog:build": "bun scripts/changelog/changelog-artifact.ts",
    "changelog:publish": "bun run artifacts:ship",
    "deps:policy": "bun scripts/dependencies/sync-dependency-policy.ts",
    "deps:policy:check": "bun scripts/dependencies/sync-dependency-policy.ts --check",
    "build": "bun scripts/core/prepare-build.ts && bun x tsgo -p tsconfig.json",
    "typecheck": "bun x tsgo --noEmit -p tsconfig.json",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "version:check": "bun scripts/release/check-release-version.ts",
    "naming:branch": "bun scripts/changes/validate-change-name.ts branch",
    "naming:pr": "bun scripts/changes/validate-change-name.ts pr-title",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "bun run build && bun test --isolate --timeout 30000",
    "test:coverage": "bun run build && bun scripts/coverage/clean-coverage.ts && bun test --isolate --coverage --timeout 30000 && bun scripts/coverage/render-coverage-report.ts && bun scripts/coverage/render-coverage-pdf.ts",
    "codeql:scan": "bun scripts/security/codeql-scan.ts",
    "docs:build": "bun scripts/docs/document-artifact.ts artifact-generator",
    "diagrams:validate": "bun run build && bun dist/scripts/diagrams/validate-diagrams.js",
    "diagrams:render": "bun run build && bun dist/scripts/diagrams/render-diagrams.js",
    "diagrams:open": "bun run build && bun dist/scripts/diagrams/open-diagrams.js",
    "diagrams:render:open": "bun run build && bun dist/scripts/diagrams/render-open-diagrams.js",
    "resume:build": "bun scripts/resume/build-resume.ts",
    "release:publish": "bun run version:check && bun run changelog:publish",
    "prepare": "bun scripts/git-hooks/setup-git-hooks.ts",
    "verify": "bun run naming:branch && bun run version:check && bun run audit && bun run check && bun run test && bun run codeql:scan"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "marked": "^18.0.9",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "pdfkit": "^0.19.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "string-width": "4.2.3",
    "ws": "8.21.0"
  }
}
