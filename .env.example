# Local Artifact Generator configuration.
# Copy to .env and fill the bucket/distribution values for your AWS account.

AWS_REGION=us-east-1

# Raw content, image, and icon inputs pulled before generating publish bundles.
SOURCE_ARTIFACTS_BUCKET=
SOURCE_ARTIFACTS_PREFIX=
SOURCE_ASSETS_BUCKET=
SOURCE_ASSETS_PREFIX=

# Publish destinations for generated CloudFront bundles.
ARTIFACTS_BUCKET=
ARTIFACTS_PREFIX=
ARTIFACTS_CLOUDFRONT_DISTRIBUTION_ID=
ASSETS_BUCKET=
ASSETS_PREFIX=
ASSETS_CLOUDFRONT_DISTRIBUTION_ID=

# Public origins consumed by the portfolio app after publish.
# Use CloudFront distribution domain names, such as
# https://d111111abcdef8.cloudfront.net, or custom domains after DNS exists.
# Do not use CloudFront distribution IDs, such as E1CSMY761RI4LF, as URL hosts.
VITE_PUBLIC_ARTIFACTS_ORIGIN=https://artifacts.connorhunter.me
VITE_PUBLIC_ASSETS_ORIGIN=https://assets.connorhunter.me

# Optional local browser override for Mermaid/Puppeteer rendering.
PUPPETEER_EXECUTABLE_PATH=
